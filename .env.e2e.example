# NAS hostname or IP
NAS_HOST=your-nas-hostname-or-ip

# SSH target for the tests that need `docker exec` against the stack — VPN leak
# detection, the killswitch, and the Pi-hole port-publication guard. Optional:
# leave it unset and NAS_HOST is used instead. Needs key-based auth already
# working, since the tests never prompt for a password.
#
# Without a reachable NAS these tests FAIL rather than skip, on purpose — a leak
# check that did not run is an unverified result, not a passing one. If you have
# no NAS to point at, opt out explicitly and visibly:
#
#     ALLOW_UNVERIFIED_VPN=1 npm run test:e2e
#
# NAS_SSH=your-ssh-host-alias

# Traefik's macvlan IP on the LAN — same value as TRAEFIK_LAN_IP in .env.
# Used by networking.spec.ts to prove .lan routing works end to end. Leave
# unset and those tests skip rather than fail.
TRAEFIK_LAN_IP=192.168.1.11

# API keys (Settings → General in each app)
RADARR_API_KEY=your_radarr_api_key
SONARR_API_KEY=your_sonarr_api_key
PROWLARR_API_KEY=your_prowlarr_api_key
SABNZBD_API_KEY=your_sabnzbd_api_key
BAZARR_API_KEY=your_bazarr_api_key

# Login credentials
JELLYFIN_USERNAME=your_jellyfin_username
JELLYFIN_PASSWORD=your_jellyfin_password
QBIT_USERNAME=admin
QBIT_PASSWORD=your_qbit_password
PIHOLE_PASSWORD=your_pihole_password
SONARR_USERNAME=your_sonarr_username
SONARR_PASSWORD=your_sonarr_password
RADARR_USERNAME=your_radarr_username
RADARR_PASSWORD=your_radarr_password
PROWLARR_USERNAME=your_prowlarr_username
PROWLARR_PASSWORD=your_prowlarr_password
